{
  "name": "qibla-line",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "deploy:pages": "npm run build && npx wrangler pages deploy dist --project-name qibla-line --branch main --commit-dirty=true",
    "deploy:workers": "npm run build && npx wrangler deploy",
    "deploy": "npm run deploy:pages"
  },
  "dependencies": {
    "lucide-react": "latest",
    "maplibre-gl": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest",
    "wrangler": "latest"
  }
}
