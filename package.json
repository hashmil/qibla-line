{
  "name": "qibla-line",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "check:clean": "test -z \"$(git status --porcelain --untracked-files=no)\"",
    "deploy:pages": "npm run build && npm run check:clean && npx wrangler pages deploy dist --project-name qibla-line --branch main",
    "deploy:workers": "npm run build && npx wrangler deploy",
    "deploy": "npm run deploy:pages"
  },
  "dependencies": {
    "lucide-react": "1.21.0",
    "maplibre-gl": "5.24.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/node": "26.0.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "typescript": "6.0.3",
    "vite": "8.1.0",
    "vitest": "4.1.9",
    "wrangler": "4.105.0"
  }
}
